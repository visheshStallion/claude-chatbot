# Which backend to use: groq or anthropic
PROVIDER=groq

# Groq
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-opus-5

# Lead email - used by /api/lead to deliver partnership enquiries gathered
# in chat. All five are required for /api/lead to work; the rest of the
# app runs fine without them.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@stalliongroup.com
LEAD_EMAIL_TO=partnerships@stalliongroup.com
